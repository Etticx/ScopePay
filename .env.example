# Copy to .env.local. Never commit .env.local.
# Without API keys, the app runs a clearly labelled local demonstration.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# PayPal SANDBOX only. Use a sandbox business seller and personal buyer.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SELLER_EMAIL=
PAYPAL_WEBHOOK_ID=

# Required to protect the owner dashboard on any hosted deployment.
# Use a long random password and a separate random secret (at least 32 characters).
APP_PASSWORD=
SESSION_SECRET=

# Set to the exact origin serving ScopePay; use the public HTTPS origin when deploying.
APP_URL=http://127.0.0.1:3000
# Local data persists in .data/workspace.json. Hosting requires a persistent disk.
# DATA_DIR=/var/data/scopepay
